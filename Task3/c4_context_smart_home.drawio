<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Контекст — Умный дом" id="ctx-smart-home">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ctx-1" value="&lt;b&gt;Диаграмма контекста (C4, уровень 1): сервисы «Умный дом» — интеллектуальный домофон и шлагбаум&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="1500" height="40" as="geometry"/></mxCell>
        <object placeholders="1" c4Name="Собственник / житель" c4Type="Person" c4Description="Владелец квартиры и члены его семьи. Пользуется мобильным приложением, проходит в дом по лицу, въезжает по номеру автомобиля" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-2"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="200" height="180" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Посетитель" c4Type="Person" c4Description="Гость, курьер, сотрудник службы. Звонит в квартиру через домофон" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-3"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="1380" y="0" width="200" height="180" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Сотрудник УК (диспетчер)" c4Type="Person" c4Description="Управляет доступом на территорию ЖК, обрабатывает обращения жильцов" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-4"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="-80" y="0" width="200" height="180" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="PropDevelopment" c4Type="Software System" c4Description="Мобильное приложение собственников и сервисы ЖКУ. Новое: управление доступом жильцов, гостевые пропуска, номера автомобилей, видеозвонки домофона, журнал проходов" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="480" y="380" width="360" height="170" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Платформа «Умный дом» партнёра" c4Type="Software System" c4Description="Облачная платформа партнёра: управление домофонами и шлагбаумами, распознавание лиц и номеров, видеосервер, хранение биометрических шаблонов" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1300" y="380" width="360" height="170" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Интеллектуальный домофон" c4Type="Software System" c4Description="Устройство на подъезде: видеовызов, открытие по звонку, распознавание лица" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1060" y="800" width="240" height="120" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Интеллектуальный шлагбаум" c4Type="Software System" c4Description="Устройство на въезде: камера распознавания номеров, открытие по разрешённым номерам" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-8"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1500" y="800" width="240" height="120" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Единая биометрическая система" c4Type="Software System" c4Description="Государственная система (572-ФЗ). Используется партнёром, если биометрическая идентификация должна проходить через ЕБС" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-9"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=1;dashed=1;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2000" y="405" width="240" height="120" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Сервисы push-уведомлений" c4Type="Software System" c4Description="Apple APNs, Google FCM" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-10"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="540" y="800" width="240" height="120" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Поставщик ресурсов ЖКХ / УК" c4Type="Software System" c4Description="Существующая интеграция: услуги ЖКУ и информация о доме" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-11"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="-80" y="330" width="240" height="120" as="geometry"/></mxCell></object>
        <object placeholders="1" c4Name="Платёжная система" c4Type="Software System" c4Description="Существующая интеграция: оплата ЖКУ" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-12"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;strokeWidth=2;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="-80" y="520" width="240" height="120" as="geometry"/></mxCell></object>
        <mxCell id="ctx-13" value="Управляет доступом, открывает дверь и шлагбаум, принимает видеозвонки, добавляет номера авто и лица членов семьи&lt;br&gt;[Мобильное приложение, HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;" edge="1" parent="1" source="ctx-2" target="ctx-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-14" value="Проходит в подъезд по лицу или ключу" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-2" target="ctx-7"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="135"/></Array></mxGeometry></mxCell>
        <mxCell id="ctx-15" value="Въезжает на территорию по номеру автомобиля" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-2" target="ctx-8"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="90"/><mxPoint x="1270" y="300"/><mxPoint x="1620" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="ctx-16" value="Звонит в квартиру" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-3" target="ctx-7"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="250"/><mxPoint x="1240" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="ctx-17" value="Управляет списками доступа ЖК, просматривает журнал событий&lt;br&gt;[Web, HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-4" target="ctx-5"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="90"/><mxPoint x="250" y="420"/></Array></mxGeometry></mxCell>
        <mxCell id="ctx-18" value="Права доступа, номера авто, команды «открыть», запрос токенов видеосессии&lt;br&gt;[REST/HTTPS, mTLS + OAuth 2.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E8449;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-5" target="ctx-6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-19" value="События: входящий вызов, проход, отказ, статус устройства&lt;br&gt;[Webhook/HTTPS, mTLS + подпись HMAC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E8449;strokeWidth=2;exitX=0;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-6" target="ctx-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-20" value="Управляет устройством, получает видео и события&lt;br&gt;[MQTT/TLS, SRTP, защищённый канал]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-6" target="ctx-7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-21" value="Управляет устройством, получает распознанные номера&lt;br&gt;[MQTT/TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-6" target="ctx-8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-22" value="Биометрическая идентификация (при необходимости)&lt;br&gt;[API ЕБС]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;dashed=1;" edge="1" parent="1" source="ctx-6" target="ctx-9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-23" value="Уведомление о вызове домофона (без ПДн)&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;" edge="1" parent="1" source="ctx-5" target="ctx-10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-24" value="Push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-10" target="ctx-2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="860"/><mxPoint x="400" y="135"/></Array></mxGeometry></mxCell>
        <mxCell id="ctx-25" value="Услуги ЖКУ&lt;br&gt;[REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=0;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-5" target="ctx-11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-26" value="Оплата ЖКУ&lt;br&gt;[REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#828282;strokeWidth=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctx-5" target="ctx-12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-27" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;Синий — система PropDevelopment (в фокусе)&lt;br&gt;Серый — внешние системы, пунктир — используется при необходимости&lt;br&gt;Зелёные связи — новые интеграции с платформой партнёра&lt;br&gt;Устройства принадлежат партнёру и управляются только через его платформу" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-80" y="1000" width="620" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
