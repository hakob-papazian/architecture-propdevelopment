<mxfile host="app.diagrams.net" type="device">
  <diagram id="data-security-mindmap" name="Безопасность данных">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4800" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;b&gt;Безопасность данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PropDevelopment&lt;br&gt;ISO/IEC 27001 / 27002&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=20;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2300" y="865" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Публичные данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Public — раскрываются без ограничений&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=15;strokeWidth=2;arcSize=20;" vertex="1" parent="1"><mxGeometry x="2640" y="445" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="n4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#6c8ebf;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px;text-align:left&quot;&gt;&lt;li&gt;Каталог объектов недвижимости на витрине продаж: адреса ЖК, планировки, площадь, этаж, фото, цены (client-mart-estate-app / -db)&lt;/li&gt;&lt;li&gt;Каталог объектов, публикуемый через Kafka в client-tour-app&lt;/li&gt;&lt;li&gt;Публичные 3D-туры и медиаматериалы по объектам&lt;/li&gt;&lt;li&gt;Информация о застройщике, ЖК, сроках сдачи, проектные декларации&lt;/li&gt;&lt;li&gt;Маркетинговые материалы, акции, условия ипотечных программ&lt;/li&gt;&lt;li&gt;Общие объявления УК для жильцов в мобильном приложении&lt;/li&gt;&lt;li&gt;Публичные документы: политика обработки ПДн, оферты, пользовательские соглашения&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="2930" y="160" width="400" height="660" as="geometry"/></mxCell>
        <mxCell id="n6" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="175" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n8" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;Почему:&lt;/b&gt; Данные изначально опубликованы на витрине и доступны любому посетителю, включая конкурентов. Их раскрытие не наносит ущерба и не нарушает законодательство." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="150" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n10" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="315" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n12" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="n5" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;Почему:&lt;/b&gt; Данные восстанавливаются из client-mart-estate-db, резервных копий и исходных материалов. Потеря приводит лишь к кратковременной недоступности витрины." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="290" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n14" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="455" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n16" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;Почему:&lt;/b&gt; Неверная цена, площадь или статус на витрине — это публичная оферта и реклама: возможны претензии по ЗоЗПП и 38-ФЗ «О рекламе», штрафы и репутационный ущерб. Каталог передаётся через Kafka без контроля целостности." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="430" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n18" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="595" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n20" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n5" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;Почему:&lt;/b&gt; Устаревший статус объекта (проданная квартира показана свободной) приводит к ошибочным бронированиям и жалобам клиентов, снижает конверсию витрины." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="570" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n22" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="735" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n24" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="n5" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;Почему:&lt;/b&gt; Ценность публичных данных — в актуальности, а не в секретности. Обесценивание наступает только при неактуальности и закрывается риском «некачественные данные»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="710" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n26" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;Внутренние данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Internal — только для сотрудников&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=15;strokeWidth=2;arcSize=20;" vertex="1" parent="1"><mxGeometry x="2640" y="1305" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="n28" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#9673a6;" edge="1" parent="1" source="n2" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px;text-align:left&quot;&gt;&lt;li&gt;Регламенты, бизнес-процессы, оргструктура, внутренние инструкции&lt;/li&gt;&lt;li&gt;Архитектурная документация, C4-диаграммы, схемы интеграций&lt;/li&gt;&lt;li&gt;Спецификации и контракты API (внутренние и партнёрские)&lt;/li&gt;&lt;li&gt;Конфигурации инфраструктуры и CI/CD без секретов&lt;/li&gt;&lt;li&gt;Планы и история текущего и капитального ремонта (tenant-core-db)&lt;/li&gt;&lt;li&gt;Агрегированная и обезличенная BI-отчётность, статистика продаж и бронирований&lt;/li&gt;&lt;li&gt;Справочники объектов, ЖК, услуг ЖКУ, тарифов&lt;/li&gt;&lt;li&gt;Технические логи и метрики приложений без ПДн&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="2930" y="1020" width="400" height="660" as="geometry"/></mxCell>
        <mxCell id="n30" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="1035" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n32" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;b&gt;Почему:&lt;/b&gt; Схемы архитектуры и контракты API упрощают атаку на системы (разведка для злоумышленника). Статистика продаж и планы ремонтов ценны для конкурентов. Прямых штрафов нет, но растёт риск последующих инцидентов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="1010" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n34" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="1175" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n36" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="n29" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" value="&lt;b&gt;Почему:&lt;/b&gt; Большая часть данных хранится в нескольких копиях (Git, wiki, БД с резервным копированием) и восстанавливается. Утрата влияет на процессы, но не останавливает бизнес." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="1150" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n38" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n39" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="1315" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n40" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n29" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n41" value="&lt;b&gt;Почему:&lt;/b&gt; Искажённые графики ремонта вводят собственников в заблуждение, искажённые отчёты ведут к ошибочным управленческим решениям. Изменения документации не согласуются с ИБ — подмена может остаться незамеченной." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="1290" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n42" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n39" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n43" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="1455" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n44" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n29" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n45" value="&lt;b&gt;Почему:&lt;/b&gt; Сырые данные из всех БД попадают в хранилище Greenplum по CDC без очистки и нормализации. Дубли и противоречия из разных систем дают недостоверную аналитику." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="1430" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n46" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n43" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n47" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3410" y="1595" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n48" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n29" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n49" value="&lt;b&gt;Почему:&lt;/b&gt; Нет каталога данных, владельцев и единых правил хранения. Накопленные данные невозможно использовать для BI/ML/AI — это прямо блокирует запуск новых продуктов компании." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="3720" y="1570" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n50" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n51" value="&lt;b&gt;Конфиденциальные данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Confidential — ПДн и коммерческая тайна, доступ по need-to-know&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=15;strokeWidth=2;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1990" y="445" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="n52" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#d6b656;" edge="1" parent="1" source="n2" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n53" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px;text-align:left&quot;&gt;&lt;li&gt;ПДн клиентов при бронировании: ФИО, телефон, e-mail (client-crm-app, crm-db)&lt;/li&gt;&lt;li&gt;Расширенная анкета для онлайн-сделки: паспортные данные, СНИЛС, ИНН, адрес регистрации, семейное положение, доходы&lt;/li&gt;&lt;li&gt;Профили и карточки клиентов, история бронирований и осмотров, результаты онлайн-туров&lt;/li&gt;&lt;li&gt;Данные сделок: договоры ДДУ / купли-продажи, условия, ипотека, документы для Росреестра (client-mart-db)&lt;/li&gt;&lt;li&gt;ПДн собственников: ФИО, адрес и кадастровый номер квартиры, лицевые счета (CRM, crm-tenant-db)&lt;/li&gt;&lt;li&gt;Начисления и история оплат ЖКУ, задолженности, обращения в УК&lt;/li&gt;&lt;li&gt;Данные, передаваемые партнёрам (УК, поставщикам ЖКУ) по API&lt;/li&gt;&lt;li&gt;Сырые копии ПДн в хранилище данных Greenplum и DWH (S3)&lt;/li&gt;&lt;li&gt;Финансовый учёт (accountant-service-1), договоры с партнёрами и подрядчиками&lt;/li&gt;&lt;li&gt;Журналы событий «Умного дома» (присутствие, открытие двери)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1530" y="160" width="400" height="660" as="geometry"/></mxCell>
        <mxCell id="n54" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n51" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n55" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="175" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n56" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="n53" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n57" value="&lt;b&gt;Почему:&lt;/b&gt; Нарушение 152-ФЗ: оборотные штрафы (КоАП ст. 13.11, ред. 2024), уведомление РКН. ПДн по CDC реплицируются в хранилище без ограничений доступа, API УК отдают ПДн без изоляции между партнёрами. Пример конкурента показывает тяжёлые репутационные последствия." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n58" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="n55" target="n57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n59" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="315" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n60" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n61" value="&lt;b&gt;Почему:&lt;/b&gt; Утрата договоров, анкет и начислений ЖКУ срывает сделки и расчёты с собственниками. Резервное копирование есть, поэтому риск не критический, но данные дублируются в разных системах без синхронизации — часть изменений может быть потеряна." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n62" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n59" target="n61"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n63" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="455" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n64" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="n53" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n65" value="&lt;b&gt;Почему:&lt;/b&gt; Клиенты уже видят в личном кабинете чужие ФИО — нарушена целостность и разграничение доступа. Ошибка в данных ДДУ или Росреестра ведёт к недействительности сделки, ошибка в начислениях — к спорам и штрафам. Партнёр может изменить данные клиентов другой УК." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n66" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="n63" target="n65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n67" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="595" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n68" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n69" value="&lt;b&gt;Почему:&lt;/b&gt; Несколько несогласованных точек регистрации клиента: дубли и расхождения между CRM клиентов, CRM собственников и auth-service. Неверные контакты нарушают коммуникации и подготовку сделки." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="570" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n70" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n67" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n71" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="735" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n72" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n73" value="&lt;b&gt;Почему:&lt;/b&gt; Без согласий на обработку в аналитических целях и без обезличивания ПДн нельзя законно использовать для BI/ML. При утечке клиентская база теряет конкурентную ценность." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="710" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n74" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n71" target="n73"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n75" value="&lt;b&gt;Секретные данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Secret / Restricted — строго ограниченный доступ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#1a1a1a;fontColor=#ffffff;fontSize=15;strokeWidth=2;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1990" y="1305" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="n76" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#1a1a1a;" edge="1" parent="1" source="n2" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n77" value="&lt;b&gt;Данные компании:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px;text-align:left&quot;&gt;&lt;li&gt;Учётные данные пользователей и хэши паролей (auth-service-1 / Keycloak, auth-db-1)&lt;/li&gt;&lt;li&gt;Базы Active Directory: учётные записи сотрудников, группы и права доступа&lt;/li&gt;&lt;li&gt;API-ключи и токены партнёров (УК, поставщики ЖКУ, платёжная система)&lt;/li&gt;&lt;li&gt;Ключи электронной подписи и сертификаты для СМЭВ и Росреестра&lt;/li&gt;&lt;li&gt;Ключи шифрования БД и резервных копий, TLS-сертификаты&lt;/li&gt;&lt;li&gt;Ключи и коды доступа «Умного дома» и электронных замков квартир&lt;/li&gt;&lt;li&gt;Платёжные токены и реквизиты операций&lt;/li&gt;&lt;li&gt;Секреты CI/CD, пароли сервисных учётных записей к БД&lt;/li&gt;&lt;li&gt;Правила межсетевого экрана и сетевая топология&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a1a1a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1530" y="1020" width="400" height="660" as="geometry"/></mxCell>
        <mxCell id="n78" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;" edge="1" parent="1" source="n75" target="n77"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n79" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1035" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n80" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="n77" target="n79"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n81" value="&lt;b&gt;Почему:&lt;/b&gt; Компрометация ключей и паролей даёт доступ ко всем системам и данным. Ключ ЭП позволяет подписывать документы в госорганах от имени компании, коды замков дают физический доступ в квартиры — угроза жизни и имуществу собственников." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1010" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n82" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="n79" target="n81"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n83" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1175" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n84" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="n77" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n85" value="&lt;b&gt;Почему:&lt;/b&gt; Потеря ключей ЭП останавливает онлайн-сделки через СМЭВ. Потеря ключей шифрования делает бэкапы невосстановимыми. Отказ AD или Keycloak блокирует доступ ко всем продуктам." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1150" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n86" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="n83" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n87" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1315" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n88" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="n77" target="n87"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n89" value="&lt;b&gt;Почему:&lt;/b&gt; Подмена прав в AD или Keycloak — повышение привилегий и бесконтрольный доступ. Подмена реквизитов платёжной системы ведёт к прямым финансовым потерям, подмена команд «Умного дома» — к угрозе безопасности жильцов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1290" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n90" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="n87" target="n89"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n91" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1455" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n92" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="n77" target="n91"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n93" value="&lt;b&gt;Почему:&lt;/b&gt; Неотозванные учётные записи после смены руководителей IT-команд, просроченные сертификаты, ключи без ротации. Это приводит к сбоям интеграций и открывает лишние права доступа." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1430" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n94" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#d79b00;" edge="1" parent="1" source="n91" target="n93"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n95" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1595" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="n96" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#82b366;" edge="1" parent="1" source="n77" target="n95"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n97" value="&lt;b&gt;Почему:&lt;/b&gt; Ценность секретов — в их конфиденциальности, а не в аналитике. При компрометации ключ отзывается и перевыпускается (ротация). Ущерб от раскрытия уже учтён в риске утечки." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1570" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="n98" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="n95" target="n97"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n99" value="&lt;b&gt;Mindmap: классификация данных PropDevelopment и риски безопасности&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Категории по ISO/IEC 27001/27002 → данные компании → риски → оценка → обоснование&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1830" y="20" width="1200" height="70" as="geometry"/></mxCell>
        <mxCell id="n100" value="&lt;b&gt;Шкала оценки риска&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2100" y="1760" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="n101" value="Критический — прямой ущерб клиентам, штрафы, остановка бизнеса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2100" y="1795" width="660" height="32" as="geometry"/></mxCell>
        <mxCell id="n102" value="Значительный — ощутимый ущерб, устраним в разумные сроки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2100" y="1835" width="660" height="32" as="geometry"/></mxCell>
        <mxCell id="n103" value="Незначительный — ущерб минимален или легко компенсируется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2100" y="1875" width="660" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
